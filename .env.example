# Copy to .env.local for local use. Optional server-side credentials only.
# Never commit populated values or expose credentials with NEXT_PUBLIC_*.
OPENALEX_API_KEY=
USPTO_API_KEY=
DATA_GOV_API_KEY=
NEXORA_DATA_MODE=HYBRID

# AI defaults to the deterministic evidence-first provider. Put future live
# provider credentials in Sites Secrets, never in source or NEXT_PUBLIC_* vars.
NEXORA_AI_ENABLED=false
NEXORA_AI_PROVIDER=evidence-first
NEXORA_AI_API_KEY=
